# Required
# ---------------------------------------------------------------------------
# Sealing key for every token this server mints (authorization codes, access tokens,
# refresh tokens, dynamic client registrations). Any string of 16+ characters works;
# it is hashed to a 32-byte key. Rotating it invalidates every outstanding token, so
# clients simply re-run the OAuth flow.
#
#   openssl rand -base64 32
NCM_TOKEN_SECRET=

# Optional
# ---------------------------------------------------------------------------

# Public origin clients reach this deployment on. On Vercel this is derived from
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL, so it is only needed for custom domains
# or non-Vercel hosting.
# MCP_PUBLIC_ORIGIN=https://ncm-mcp.example.com

# Comma-separated toolset groups to expose. Omit or use "all" for every group.
# Groups: account, search, discover, music, library, comments, social, meta
# NCM_TOOLSETS=search,music,discover,account

# Comma-separated tool names to hide, subtracted from whatever NCM_TOOLSETS enables.
# Empty by default: no curated tool mutates account personal info or session identity,
# so the defaults need no net. Set it to hide specific wrappers; an empty value
# disables nothing. (DEFAULT_DISABLED_TOOLS in lib/config.ts holds the default list.)
# NCM_DISABLED_TOOLS=ncm_listen_stats,ncm_yunbei

# Comma-separated upstream endpoints ncm_raw refuses to proxy, also hidden from
# ncm_list_endpoints. Omit to use DEFAULT_BLOCKED_RAW_ENDPOINTS in lib/config.ts,
# which covers two cases only:
#   1. identity mutation — user_update, avatar_upload, setting, rebind, phone changes,
#      user_social_status_edit, activate_init_profile, nickname_check, logout,
#      device_kickoff, and every login*/register*/captcha* endpoint
#   2. spends money — dj_paygift, dj_toplist_pay, yunbei_expense, digitalAlbum_ordering
# Purchase history (digitalAlbum_purchased, song_purchased, digitalAlbum_sales, yunbei,
# yunbei_info, yunbei_receipt, vip_*) and download-URL endpoints stay allowed.
# A set value replaces that list; an empty value blocks nothing.
# NCM_BLOCKED_RAW_ENDPOINTS=dj_paygift,digitalAlbum_ordering

# Access token lifetime in seconds (default 3600).
# NCM_TOKEN_TTL_SECONDS=3600

# Refresh token lifetime in seconds (default 30 days).
# NCM_REFRESH_TTL_SECONDS=2592000

# Absolute cap on how long a refresh chain may keep extending one NetEase session
# (default 60 days). Past this, the user has to sign in again.
# NCM_SESSION_MAX_AGE_SECONDS=5184000

# Opt-in: when no usable client IP is present, fall back to a random Chinese IP so
# region-restricted endpoints still answer. Off by default so the forwarded client IP
# (the "FakeIP") is the only outbound address.
# NCM_FALLBACK_RANDOM_CN_IP=false

# Pre-registered OAuth clients, as "client_id:redirect_uri[,redirect_uri]" joined by ";".
# Optional: dynamic registration and CIMD both work without this.
# NCM_PRE_REGISTERED_CLIENTS=my-client:http://127.0.0.1:8090/callback

# Local development only, so `next start` knows its own origin before Vercel sets one.
# NCM_DEV_ORIGIN=http://localhost:3000
